NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_DEFAULT_LOCALE=az

# Service role key — used SERVER-SIDE, ADMIN-ONLY (the system-admin console
# creates business accounts via the Auth Admin API). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — demo-lead email alerts via Resend. Leave blank to use the in-app
# admin inbox only. DEMO_FROM_EMAIL defaults to Resend's test sender.
RESEND_API_KEY=
DEMO_NOTIFY_EMAIL=
DEMO_FROM_EMAIL=
