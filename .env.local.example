NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_DEFAULT_LOCALE=az

# Service role key — used SERVER-SIDE, ADMIN-ONLY (system-admin console: create
# business accounts, tenant password-reset links, data export, the cron route).
# Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Shared secret for the admin notifications cron endpoint (/api/admin/cron).
# An external scheduler (Vercel Cron / GitHub Action) POSTs with
# `Authorization: Bearer ${CRON_SECRET}` to regenerate time-based alerts.
# Leave blank to rely on the opportunistic refresh on each admin dashboard load.
CRON_SECRET=

# Optional — demo-lead email alerts via Resend. Leave blank to use the in-app
# admin inbox only. DEMO_FROM_EMAIL defaults to Resend's test sender.
RESEND_API_KEY=
DEMO_NOTIFY_EMAIL=
DEMO_FROM_EMAIL=
